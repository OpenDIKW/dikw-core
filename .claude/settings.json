{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'ROOT=\"${CLAUDE_PROJECT_DIR:-.}\"; PY=\"$ROOT/.venv/bin/python\"; [ -x \"$PY\" ] || PY=python3; exec \"$PY\" \"$ROOT/tools/verify_hook.py\" claude-pretool'"
          }
        ]
      }
    ]
  }
}
