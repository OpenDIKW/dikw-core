# Ignore local Claude Code state (local settings, stamps, observe logs, delivery
# artifacts) while version-controlling the shared project skills, path-scoped
# rules, and shared hook config (.claude/settings.json; keep settings.local.json
# ignored). Note: must ignore .claude/* (contents), not .claude/ (the dir), or
# git can't re-include tracked entries under an excluded parent.
.claude/*
!.claude/skills/
!.claude/rules/
!.claude/settings.json
# engine-managed state in example/test wikis
**/.dikw/
# parallel-development worktrees
.worktrees/
# throwaway smoke / debug tools under evals/tools — names prefixed with _
evals/tools/_*_smoke.py
# eval-snapshot cache (per-dataset ingested wikis; built on first eval run,
# reused across re-runs). Each snapshot is ~30-150 MB SQLite + corpus copy.
evals/.cache/
